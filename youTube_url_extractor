import re
import sys
def main():
    print (parse(input("HTML: ")))
def parse(value):
    if match := re.search(r'<iframe src="https?://(?:www\.)?youtube\.com/embed/([^"]+)',value,re.IGNORECASE):
        url = f"https://youtu.be/{match.group(1)}"
        return  url
if __name__ == "__main__":
    main()
